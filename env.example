# backup / restore-test の環境変数一覧。実際の値・秘密情報を保存しないでください。
# runner はこのファイルを自動読み込みしません。デプロイ側で環境変数として注入します。
# 必須項目の空欄は実行前に設定してください。任意項目は未設定なら既定値を使います。

# Kubernetes（restore-test 専用。backup は不要）
# 必須: スケール対象の Deployment / StatefulSet 名（RFC 1123 label）。
WEB_WORKLOAD=
DB_WORKLOAD=
# 任意: 対象 namespace。既定値 default。Pod の namespace は自動取得しません。
# default 以外で実行する場合は Downward API などで明示的に注入してください。
POD_NAMESPACE=default

# S3（両コマンド必須）: backup は指定キーへ保存、restore-test は同じ形式を取得。
# キーは拡張子まで含む完全な値。例: postgres/daily.sql.gz。世代は自動選択しません。
S3_REGION=
S3_BUCKET=
S3_KEY=
# 任意: http(s) の S3 互換 endpoint。空欄は AWS 標準、指定時は path-style。
S3_ENDPOINT=
# 認証: AWS SDK 標準 credential chain。backup 用書き込み情報と restore-test 用
# read-only 情報は分離して注入してください。HEAD に必要な読み取り権限も必要です。
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 一時認証情報の場合のみ必要。
AWS_SESSION_TOKEN=

# PostgreSQL（両コマンド必須）。backup は取得元、restore-test は検証専用の復元先。
DB_HOST=
DB_PORT=
DB_USER=
DB_PASS=
# backup のみ必須。restore-test はこの値を使わず misskey を削除・再作成します。
DB_NAME=
# 任意: gzip ダンプの一時領域。空欄なら通常 /tmp。十分なディスク容量が必要です。
TMPDIR=
# restore-test のみ任意: 復元後の ANALYZE の制限時間。整数秒、1〜2147483、既定値900。
DB_ANALYZE_TIMEOUT_SECONDS=900

# Misskey（restore-test のみ必須）: http(s)://host[:port] の origin。末尾 / は可。
# user/password、root 以外の path、query、fragment は指定不可。
MISSKEY_BASE_URL=
# 任意: GTL の時間設定。いずれも正の整数秒。以下は既定値。
# HTTP リクエスト1回の制限時間。
MISSKEY_GTL_REQUEST_TIMEOUT_SECONDS=10
# 再試行前の待機時間。
MISSKEY_GTL_RETRY_INTERVAL_SECONDS=30
# 初回試行開始から、リクエストと待機を含めた全体の制限時間。
MISSKEY_GTL_RETRY_TIMEOUT_SECONDS=300

# 両コマンド任意: Discord 通知先 webhook URL。空欄は通知なし。秘密情報として扱います。
DISCORD_NOTIFICATION_WEBHOOK=
